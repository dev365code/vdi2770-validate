# The sdist must be able to run its own tests, or a downstream packager building
# from it gets a green build that never ran the gate. This is the same class of
# error as a check that reads a path outside the repository: "the gate exists"
# and "the gate runs" differ only in someone else's environment.
include LICENSE NOTICE THIRD_PARTY.md CHANGELOG.md CONTRIBUTING.md SECURITY.md Makefile
recursive-include tests *.py *.json
recursive-include tools *.py *.java *.md
recursive-include corpus *
recursive-include docs *.md *.json
recursive-include .github *.yml
# The reader ships inside this distribution and its source lives here; so does
# the manifest for `vdi2770-validate`, the name this project published under
# until 0.6.0, which is built from this repository too. An sdist without them
# would run a suite that cannot import half of itself, and would not be able to
# build the other distribution at all.
recursive-include packages *.py *.toml *.md *.in *.ini *.json
# Extensionless names need naming: the recursive-include patterns above are
# by suffix, and LICENSE and NOTICE have none. The sdist gate caught the
# NOTICE being missing here, which is exactly what it is for.
include packages/vdi2770/LICENSE packages/vdi2770/NOTICE packages/vdi2770/src/vdi2770/py.typed
include packages/vdi2770-validate/LICENSE packages/vdi2770-validate/NOTICE
prune tests/fixtures
# `recursive-include packages ... *.md` matches `.pytest_cache/README.md`, so an
# sdist built in a tree somebody had run the suite in carried pytest's cache.
# Gitignored is not the same as excluded: MANIFEST.in decides what ships.
global-exclude .pytest_cache/*
prune packages/vdi2770/.pytest_cache

# Working notes are not part of the distribution.
exclude CLAUDE.md AGENTS.md
prune .claude
exclude docs/findings.md docs/audits.md
